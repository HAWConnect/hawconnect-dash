Dockerfile
.dockerignore
node_modules
npm-debug.log
README.md
.git
.output
.tanstack
.env
.env*.local

# Private configuration and Git metadata are not Docker build inputs
.git
.env
.env.*
.envrc
.private
secrets
credentials
credentials.json
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.mobileprovision
**/service-account*.json
**/*service-account-key*.json

# Dependencies, build exports, caches and private operational files
**/node_modules
**/.pnpm-store
**/.npm
**/.bun
**/.cache
**/coverage
**/playwright-report
**/test-results
**/*.log
**/*.tsbuildinfo
**/*.apk
**/*.aab
**/*.ipa
**/*.zip
/dist
/dist-*
/.output
/.tanstack
/outputs
/backups
/database-dumps
/private-imports
**/*.dump
**/*.backup
**/*.sql.gz
/*.ics
/*.ical

# Apply private-configuration exclusions at any directory depth
**/.git
**/.env
**/.env.*
**/.envrc
**/.private
**/secrets
**/credentials
**/credentials.json

# Additional SSH keys and Apple provisioning files
**/id_rsa
**/id_ed25519
**/*.provisionprofile

# Local development provenance and historical design material (not publication inputs)
/docs/upstream/
/docs/superpowers/
/.agents/
/config/github/architecture.svg

# Publish only student-facing documentation; keep internal reports local
/docs/*
!/docs/README.md
!/docs/students/
